rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Sửa danh sách email admin cho trùng với config.js
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['email-admin@gmail.com'];
    }

    // Cài đặt tài khoản nhận tiền, giờ chốt: ai đăng nhập cũng đọc được, chỉ admin sửa
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Menu theo ngày: chỉ admin đăng / sửa
    match /menus/{day} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Đơn của từng người: mỗi người chỉ sửa đơn của mình, admin sửa được tất cả (xác nhận đã nhận tiền)
    match /orders/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
